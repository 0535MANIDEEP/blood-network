# Every environment variable the code actually reads.
# Nothing here is required to run locally. With no .env at all the server boots
# on a local PGlite database and refuses nothing it should not.
#
# Copy to .env only if you need to change something.

# ---- Runtime ---------------------------------------------------------------

# "production" makes two refusals load bearing: the unreviewed regulatory policy
# throws instead of warning, and enforceBoundary blocks the boot. Leave unset for
# local development, where both only warn.
NODE_ENV=

PORT=4000

# ---- Database --------------------------------------------------------------

# Unset uses a local PGlite directory, so no PostgreSQL install is needed.
# Set it to run against a real server, pooled, with no code change.
DATABASE_URL=

# Where the local PGlite database lives. Git ignored.
PGLITE_DIR=./.pgdata

# ---- Cookies and CORS ------------------------------------------------------

# "false" is needed for a plain http local run, because a browser drops a Secure
# cookie over http and every session would silently fail to persist.
# Never set this to false behind TLS.
SECURE_COOKIES=true

# Comma separated. An origin not on this list is refused rather than reflected.
# Reflecting the caller's origin alongside credentials lets any website the user
# visits make authenticated requests here, so there is deliberately no wildcard
# and no "true means allow any".
ALLOWED_ORIGINS=

# ---- Public endpoint rate limit -------------------------------------------

# Raising a request is unauthenticated on purpose, which means it is the only
# thing standing between a public write endpoint and a spam relay.
PUBLIC_RATE_LIMIT=30
PUBLIC_RATE_WINDOW_MS=60000

# ---- Boundary switches -----------------------------------------------------

# "false" lets the boot assert that no real patient records were loaded.
# Setting it to anything else blocks startup on purpose.
SEED_MODE=true

# Notification recipients. Only "fixtures" or "none" are accepted; anything else
# blocks startup, because reaching a real phone during a real emergency makes
# people act on this software's output.
NOTIFY_RECIPIENTS=fixtures

# Only "fixtures" is accepted. Setting anything else blocks startup, because
# accepting a genuine licensed bank supplying genuine stock turns a directory
# into a supply chain.
BANK_SUPPLY_MODE=fixtures

# Deliberately awkward. Setting ALLOW_REAL_DATA=true does NOT permit a
# deployment on its own; it also requires a reviewed regulatory policy, so it can
# never be the thing that carries a real deployment. Do not set it.
# ALLOW_REAL_DATA=
